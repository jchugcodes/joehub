{
  "openapi": "3.1.0",
  "info": {
    "title": "joehub public read API",
    "version": "0.1.0",
    "description": "Synthetic contract shared by the Next.js route handlers and the optional FastAPI process. Paths are /api/... on both origins. On the Next.js origin, /finance/accounts without the /api prefix is the UI page and returns HTML, not this contract. Finance routes are a synthetic read model. Jobs and journal routes are read-only fixtures. POST /api/tasks creates one unfinished task and honors an Idempotency-Key for about 24 hours. POST /api/grocery creates one grocery item and honors an Idempotency-Key for about 24 hours. No raw SQL, file download, or export. The browser authenticates with the joehub_session cookie."
  },
  "servers": [
    {
      "url": "/",
      "description": "Next.js route handlers on the site origin. Request /api/finance/accounts on this origin. A request to /finance/accounts is the UI shell and returns HTML."
    },
    {
      "url": "/",
      "description": "Optional FastAPI process on its own origin. The same /api paths are served there. No extra host is required to run the synthetic shell, and this process is not deployed."
    }
  ],
  "paths": {
    "/api/finance/overview": {
      "get": {
        "operationId": "financeOverview",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "week", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "range", "in": "query", "required": false, "schema": { "type": "string", "enum": ["1W", "1M", "YTD", "1Y", "All"] } }
        ],
        "responses": { "200": { "description": "Synthetic week, caps, and chart" } }
      }
    },
    "/api/finance/weeks/{start}/categories/{category}": {
      "get": {
        "operationId": "financeCategory",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "start", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "category", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Synthetic category rows for one week" } }
      }
    },
    "/api/finance/caps": {
      "patch": {
        "operationId": "financeSaveCaps",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Saved weekly caps. The set total stays $390." },
          "400": { "description": "Invalid amount or the set total changed." }
        }
      }
    },
    "/api/finance/accounts": {
      "get": {
        "operationId": "financeAccounts",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic account snapshot" } }
      }
    },
    "/api/finance/goals": {
      "get": {
        "operationId": "financeGoals",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic goals" } }
      }
    },
    "/api/finance/transactions": {
      "get": {
        "operationId": "financeTransactions",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic transactions" } }
      }
    },
    "/api/jobs/applications": {
      "get": {
        "operationId": "jobApplications",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic applications" } }
      }
    },
    "/api/jobs/statuses": {
      "get": {
        "operationId": "jobStatuses",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic status counts" } }
      }
    },
    "/api/journal/entries": {
      "get": {
        "operationId": "journalEntries",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic journal entries" } }
      }
    },
    "/api/journal/events": {
      "get": {
        "operationId": "journalEvents",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic events" } }
      }
    },
    "/api/tasks": {
      "get": {
        "operationId": "listTasks",
        "description": "Unfinished tasks, newest first. With q, also include matching tasks completed in the last 7 days. Done tasks older than 7 days are deleted on this call.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Case-insensitive match on title, notes, and project."
          }
        ],
        "responses": {
          "200": { "description": "Unfinished tasks" },
          "401": { "description": "Authentication required" },
          "503": { "description": "Store unavailable" }
        }
      },
      "post": {
        "operationId": "createTask",
        "description": "Create one task. Title is required. notes, dueDate (YYYY-MM-DD, America/Detroit), priority (High, Medium, Low), project, and status (To do, Doing, or Blocked; default To do) are optional. Done is rejected. The same Idempotency-Key replays this response for about 24 hours.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string" },
                  "notes": { "type": "string" },
                  "dueDate": { "type": "string", "description": "Calendar date YYYY-MM-DD." },
                  "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
                  "status": { "type": "string", "enum": ["To do", "Doing", "Blocked"] },
                  "project": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created task, or the task already stored for this Idempotency-Key" },
          "400": { "description": "Invalid task" },
          "401": { "description": "Authentication required" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/api/tasks/{id}": {
      "get": {
        "operationId": "getTask",
        "description": "One task by id, including a task that is not on the unfinished list.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The task",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } }
          },
          "401": { "description": "Authentication required" },
          "404": { "description": "Task not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      },
      "patch": {
        "operationId": "patchTask",
        "description": "Change any field. Send null to clear notes, dueDate, priority, or project. Title cannot be cleared. Status is To do, Doing, Blocked, or Done. Choosing Done completes the task: completedAt is set and the task leaves the unfinished list. dueDate may be YYYY-MM-DD or today, which is the America/Detroit calendar day. updatedAt changes.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskPatch" } } }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } }
          },
          "400": { "description": "Invalid task" },
          "401": { "description": "Authentication required" },
          "404": { "description": "Task not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      },
      "delete": {
        "operationId": "deleteTask",
        "description": "Permanently remove a task. It disappears from the unfinished list and from search. A missing id is 404.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Deleted" },
          "401": { "description": "Authentication required" },
          "404": { "description": "Task not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/api/tasks/{id}/complete": {
      "post": {
        "operationId": "completeTask",
        "description": "Mark a task Done and set completedAt. It leaves the default unfinished list. Repeating this keeps the original completedAt.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Completed task",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } }
          },
          "401": { "description": "Authentication required" },
          "404": { "description": "Task not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/api/tasks/{id}/reopen": {
      "post": {
        "operationId": "reopenTask",
        "description": "Set a Done task back to To do and clear completedAt so it returns to the default list.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Reopened task",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } }
          },
          "401": { "description": "Authentication required" },
          "404": { "description": "Task not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/api/grocery": {
      "get": {
        "operationId": "listGrocery",
        "description": "Every grocery item, unchecked and checked. The client groups unchecked items by section, with No section last, then Checked.",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Grocery items",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/GroceryItem" } }
              }
            }
          },
          "401": { "description": "Authentication required" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      },
      "post": {
        "operationId": "createGroceryItem",
        "description": "Create one item. Name is required. quantity, notes, and section are optional. Unknown fields are rejected. The same Idempotency-Key replays this response for about 24 hours. Duplicate names are separate items.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GroceryCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created item, or the item already stored for this Idempotency-Key",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroceryItem" } } }
          },
          "400": { "description": "Invalid item" },
          "401": { "description": "Authentication required" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/api/grocery/clear-checked": {
      "post": {
        "operationId": "clearCheckedGrocery",
        "description": "Delete every checked item. Unchecked items stay. An empty checked set deletes nothing.",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "How many checked items were deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["deleted", "ids"],
                  "properties": {
                    "deleted": { "type": "integer" },
                    "ids": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Authentication required" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/api/grocery/{id}": {
      "get": {
        "operationId": "getGroceryItem",
        "description": "One grocery item by id.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The item",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroceryItem" } } }
          },
          "401": { "description": "Authentication required" },
          "404": { "description": "Item not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      },
      "patch": {
        "operationId": "patchGroceryItem",
        "description": "Rename an item or change its quantity, notes, and section. An empty quantity, notes, or section clears that field. Name cannot be cleared. checked is not accepted.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroceryPatch" } } }
        },
        "responses": {
          "200": {
            "description": "Updated item",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroceryItem" } } }
          },
          "400": { "description": "Invalid item" },
          "401": { "description": "Authentication required" },
          "404": { "description": "Item not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      },
      "delete": {
        "operationId": "deleteGroceryItem",
        "description": "Permanently delete one item.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The item is gone",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["deleted", "id"],
                  "properties": {
                    "deleted": { "type": "boolean" },
                    "id": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Authentication required" },
          "404": { "description": "Item not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/api/grocery/{id}/check": {
      "post": {
        "operationId": "checkGroceryItem",
        "description": "Mark one item checked. Repeating it returns the same item. The item stays on the list in the Checked group.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The checked item",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroceryItem" } } }
          },
          "401": { "description": "Authentication required" },
          "404": { "description": "Item not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/api/grocery/{id}/uncheck": {
      "post": {
        "operationId": "uncheckGroceryItem",
        "description": "Mark one item unchecked and return it to its section. Repeating it returns the same item.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The unchecked item",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroceryItem" } } }
          },
          "401": { "description": "Authentication required" },
          "404": { "description": "Item not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/api/session/login": {
      "post": {
        "operationId": "sessionLogin",
        "description": "Dev-only fake login. Refused in production.",
        "responses": { "200": { "description": "Sets the session cookie" } }
      }
    },
    "/api/session/logout": {
      "post": {
        "operationId": "sessionLogout",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Revokes the current session" } }
      }
    },
    "/api/session/devices": {
      "get": {
        "operationId": "sessionDevices",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Device registry for this process" } }
      }
    },
    "/api/session/devices/{device_id}/revoke": {
      "post": {
        "operationId": "sessionRevokeDevice",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "Revokes the device and its session" } }
      }
    }
  },
  "components": {
    "schemas": {
      "GroceryItem": {
        "type": "object",
        "required": ["id", "name", "checked", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "quantity": { "type": "string", "description": "Free-text amount such as 6 or 1 carton." },
          "section": { "type": "string" },
          "notes": { "type": "string" },
          "checked": { "type": "boolean" },
          "createdAt": { "type": "integer" },
          "updatedAt": { "type": "integer" },
          "checkedAt": { "type": "integer" }
        }
      },
      "GroceryPatch": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": { "type": "string" },
          "quantity": { "type": "string" },
          "notes": { "type": "string" },
          "section": { "type": "string" }
        }
      },
      "GroceryCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "quantity": { "type": "string" },
          "notes": { "type": "string" },
          "section": { "type": "string" }
        }
      },
      "Task": {
        "type": "object",
        "required": ["id", "title", "status", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "notes": { "type": "string" },
          "dueDate": { "type": "string", "description": "Calendar date YYYY-MM-DD in America/Detroit." },
          "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
          "status": { "type": "string", "enum": ["To do", "Doing", "Blocked", "Done"] },
          "project": { "type": "string" },
          "bot": {
            "type": "object",
            "description": "Read-only progress for a task a bot already owns. Not accepted on create or patch.",
            "required": ["name", "detail"],
            "properties": {
              "name": { "type": "string" },
              "detail": { "type": "string" },
              "progress": { "type": "integer", "minimum": 0, "maximum": 100 }
            }
          },
          "createdAt": { "type": "integer" },
          "updatedAt": { "type": "integer" },
          "completedAt": { "type": "integer" }
        }
      },
      "TaskPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "notes": { "type": ["string", "null"] },
          "dueDate": { "type": ["string", "null"], "description": "YYYY-MM-DD, or today for the America/Detroit calendar day. Null clears it." },
          "priority": { "type": ["string", "null"], "enum": ["High", "Medium", "Low", null] },
          "status": { "type": "string", "enum": ["To do", "Doing", "Blocked", "Done"] },
          "project": { "type": ["string", "null"] }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "joehub_session",
        "description": "HttpOnly, Secure, SameSite=Lax session id. Expiry is stored server-side for 14 days and does not roll."
      }
    }
  }
}
