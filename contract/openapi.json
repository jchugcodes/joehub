{
  "openapi": "3.1.0",
  "info": {
    "title": "joehub public read API",
    "version": "0.1.0",
    "description": "Synthetic contract shared by the Next.js route handlers and the optional FastAPI process. Paths are /api/... on both origins. On the Next.js origin, /finance/accounts without the /api prefix is the UI page and returns HTML, not this contract. Finance, jobs, and journal routes are read-only fixtures. POST /api/tasks creates one unfinished task and honors an Idempotency-Key for about 24 hours. No raw SQL, file download, or export. The browser authenticates with the joehub_session cookie."
  },
  "servers": [
    {
      "url": "/",
      "description": "Next.js route handlers on the site origin. Request /api/finance/accounts on this origin. A request to /finance/accounts is the UI shell and returns HTML."
    },
    {
      "url": "/",
      "description": "Optional FastAPI process on its own origin. The same /api paths are served there. No extra host is required to run the synthetic shell, and this process is not deployed."
    }
  ],
  "paths": {
    "/api/finance/accounts": {
      "get": {
        "operationId": "financeAccounts",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic account balances" } }
      }
    },
    "/api/finance/transactions": {
      "get": {
        "operationId": "financeTransactions",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic transactions" } }
      }
    },
    "/api/jobs/applications": {
      "get": {
        "operationId": "jobApplications",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic applications" } }
      }
    },
    "/api/jobs/statuses": {
      "get": {
        "operationId": "jobStatuses",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic status counts" } }
      }
    },
    "/api/journal/entries": {
      "get": {
        "operationId": "journalEntries",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic journal entries" } }
      }
    },
    "/api/journal/events": {
      "get": {
        "operationId": "journalEvents",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic events" } }
      }
    },
    "/api/tasks": {
      "get": {
        "operationId": "listTasks",
        "description": "Unfinished tasks, newest first. With q, also include matching tasks completed in the last 7 days. Done tasks older than 7 days are deleted on this call.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Case-insensitive match on title, notes, and project."
          }
        ],
        "responses": {
          "200": { "description": "Unfinished tasks" },
          "401": { "description": "Authentication required" },
          "503": { "description": "Store unavailable" }
        }
      },
      "post": {
        "operationId": "createTask",
        "description": "Create one task. Title is required. notes, dueDate (YYYY-MM-DD, America/Detroit), priority (High, Medium, Low), project, and status (To do, Doing, or Blocked; default To do) are optional. Done is rejected. The same Idempotency-Key replays this response for about 24 hours.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string" },
                  "notes": { "type": "string" },
                  "dueDate": { "type": "string", "description": "Calendar date YYYY-MM-DD." },
                  "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
                  "status": { "type": "string", "enum": ["To do", "Doing", "Blocked"] },
                  "project": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created task, or the task already stored for this Idempotency-Key" },
          "400": { "description": "Invalid task" },
          "401": { "description": "Authentication required" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/api/tasks/{id}": {
      "get": {
        "operationId": "getTask",
        "description": "One task by id, including a task that is not on the unfinished list.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The task",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } }
          },
          "401": { "description": "Authentication required" },
          "404": { "description": "Task not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      },
      "patch": {
        "operationId": "patchTask",
        "description": "Change any field. Send null to clear notes, dueDate, priority, or project. Title cannot be cleared. Status is To do, Doing, or Blocked. dueDate may be YYYY-MM-DD or today, which is the America/Detroit calendar day. Done is rejected. updatedAt changes.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskPatch" } } }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } }
          },
          "400": { "description": "Invalid task" },
          "401": { "description": "Authentication required" },
          "404": { "description": "Task not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/api/tasks/{id}/complete": {
      "post": {
        "operationId": "completeTask",
        "description": "Mark a task Done and set completedAt. It leaves the default unfinished list. Repeating this keeps the original completedAt.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Completed task",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } }
          },
          "401": { "description": "Authentication required" },
          "404": { "description": "Task not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/api/tasks/{id}/reopen": {
      "post": {
        "operationId": "reopenTask",
        "description": "Set a Done task back to To do and clear completedAt so it returns to the default list.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Reopened task",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } }
          },
          "401": { "description": "Authentication required" },
          "404": { "description": "Task not found" },
          "429": { "description": "Rate limit" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/api/session/login": {
      "post": {
        "operationId": "sessionLogin",
        "description": "Dev-only fake login. Refused in production.",
        "responses": { "200": { "description": "Sets the session cookie" } }
      }
    },
    "/api/session/logout": {
      "post": {
        "operationId": "sessionLogout",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Revokes the current session" } }
      }
    },
    "/api/session/devices": {
      "get": {
        "operationId": "sessionDevices",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Device registry for this process" } }
      }
    },
    "/api/session/devices/{device_id}/revoke": {
      "post": {
        "operationId": "sessionRevokeDevice",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "Revokes the device and its session" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "required": ["id", "title", "status", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "notes": { "type": "string" },
          "dueDate": { "type": "string", "description": "Calendar date YYYY-MM-DD in America/Detroit." },
          "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
          "status": { "type": "string", "enum": ["To do", "Doing", "Blocked", "Done"] },
          "project": { "type": "string" },
          "createdAt": { "type": "integer" },
          "updatedAt": { "type": "integer" },
          "completedAt": { "type": "integer" }
        }
      },
      "TaskPatch": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "notes": { "type": ["string", "null"] },
          "dueDate": { "type": ["string", "null"], "description": "YYYY-MM-DD, or today for the America/Detroit calendar day. Null clears it." },
          "priority": { "type": ["string", "null"], "enum": ["High", "Medium", "Low", null] },
          "status": { "type": "string", "enum": ["To do", "Doing", "Blocked"] },
          "project": { "type": ["string", "null"] }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "joehub_session",
        "description": "HttpOnly, Secure, SameSite=Lax session id. Expiry is stored server-side for 14 days and does not roll."
      }
    }
  }
}
