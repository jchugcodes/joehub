{
  "openapi": "3.1.0",
  "info": {
    "title": "joehub public read API",
    "version": "0.1.0",
    "description": "Read-only synthetic contract shared by the Next.js route handlers and the separable Python API. No raw SQL, file download, export, or domain write. Session routes are the only POST routes. The browser authenticates with the joehub_session cookie."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/finance/accounts": {
      "get": {
        "operationId": "financeAccounts",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic account balances" } }
      }
    },
    "/finance/transactions": {
      "get": {
        "operationId": "financeTransactions",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic transactions" } }
      }
    },
    "/jobs/applications": {
      "get": {
        "operationId": "jobApplications",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic applications" } }
      }
    },
    "/jobs/statuses": {
      "get": {
        "operationId": "jobStatuses",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic status counts" } }
      }
    },
    "/journal/entries": {
      "get": {
        "operationId": "journalEntries",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic journal entries" } }
      }
    },
    "/journal/events": {
      "get": {
        "operationId": "journalEvents",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Synthetic events" } }
      }
    },
    "/session/login": {
      "post": {
        "operationId": "sessionLogin",
        "description": "Dev-only fake login. Refused in production.",
        "responses": { "200": { "description": "Sets the session cookie" } }
      }
    },
    "/session/logout": {
      "post": {
        "operationId": "sessionLogout",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Revokes the current session" } }
      }
    },
    "/session/devices": {
      "get": {
        "operationId": "sessionDevices",
        "security": [{ "sessionCookie": [] }],
        "responses": { "200": { "description": "Device registry for this process" } }
      }
    },
    "/session/devices/{device_id}/revoke": {
      "post": {
        "operationId": "sessionRevokeDevice",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "Revokes the device and its session" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "joehub_session",
        "description": "HttpOnly, Secure, SameSite=Lax session id. Expiry is stored server-side for 14 days and does not roll."
      }
    }
  }
}
